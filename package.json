{
  "name": "imstuckonmars-help",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "typecheck": "wrangler types --include-runtime=false && tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run && node --test scripts/models/models.test.mjs",
    "models:build": "node scripts/models/build.mjs",
    "models:test": "node --test scripts/models/models.test.mjs",
    "pipe:check": "node pipelines/check-env.ts",
    "pipe:mola": "node pipelines/stable/mola-terrain.ts",
    "pipe:hab-terrain": "node pipelines/stable/hab-terrain.ts",
    "pipe:hab-imagery": "node pipelines/stable/hab-imagery.ts",
    "pipe:display-terrain": "node pipelines/stable/display-terrain.ts",
    "pipe:globe-imagery": "node pipelines/stable/globe-imagery.ts",
    "maps:prepare": "node pipelines/prepare-map-release.ts",
    "maps:upload": "python3 pipelines/upload-map-assets.py",
    "maps:verify": "python3 pipelines/verify-map-release.py",
    "maps:restore": "node pipelines/restore-map-archive.ts",
    "pipe:sites": "node pipelines/stable/hirise-sites.ts",
    "pipe:slope": "node pipelines/stable/slope.ts",
    "sites:package": "node pipelines/package-sites-release.ts"
  },
  "dependencies": {
