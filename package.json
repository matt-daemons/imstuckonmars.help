    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "vinext": "^1.4.5",
    "vosk-browser": "0.0.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^5.20261113.1",
