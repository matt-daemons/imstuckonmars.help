{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imstuckonmars-help",
  "account_id": "c9f498eef7a97c90a87c47f676709e7d",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "imstuckonmars",
      "database_id": "c871c402-d2a0-4ba3-8ed6-0e5509039c9e",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "TELEMETRY_RELEASE": "nasa-demo-50k-v1",
    "RADIATION_RELEASE": "nasa-rad-sol816-v1",
    "DIAGNOSTICS_PROVIDER": "openrouter",
    "DIAGNOSTICS_MODEL": "openai/gpt-4.1-mini",
  },
  "observability": { "enabled": true },
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"],
  },
}
